{
  "name": "@uride/pricing-py",
  "version": "0.0.0",
  "private": true,
  "description": "FastAPI pricing service. Standalone — optional npm script shortcuts for ruff/mypy/pytest/uvicorn; real deploy uses pyproject.toml + Dockerfile.",
  "scripts": {
    "build": "echo 'pricing-py: no build (python)'",
    "dev": "uvicorn app.main:app --reload --port 5000 --host 0.0.0.0",
    "start": "uvicorn app.main:app --port 5000 --host 0.0.0.0",
    "lint": "python -m ruff check .",
    "typecheck": "python -m mypy app",
    "test": "python -m pytest -q",
    "clean": "rimraf .pytest_cache .mypy_cache .ruff_cache .turbo"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
